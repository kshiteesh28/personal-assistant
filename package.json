{
  "name": "personal-secretary",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "kst": "node scripts/kst.mjs start",
    "kst:doctor": "node scripts/kst.mjs doctor",
    "kst:release:check": "node packages/kst-core/native/understanding/release-check.mjs --run-checks",
    "kst:release:activate": "node packages/kst-core/native/understanding/release-check.mjs --run-checks --activate",
    "kst:ml:build": "node packages/kst-core/native/understanding/build.mjs",
    "kst:ml:test": "node --test packages/kst-core/test/understanding/*.test.mjs",
    "kst:test": "node scripts/kst.mjs test",
    "kst:build-mac": "node scripts/kst.mjs build-mac",
    "kst:package-mac": "node scripts/kst.mjs package-mac",
    "dev": "concurrently -n server,web -c blue,green \"bun run --cwd packages/server dev\" \"bun run --cwd packages/web dev\"",
    "server": "bun run --cwd packages/server start",
    "web": "bun run --cwd packages/web dev",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "kst:ml:evaluate": "node packages/kst-core/native/understanding/evaluate-release-corpus.mjs",
    "kst:google:test": "node --test packages/kst-core/test/google/*.test.mjs packages/kst-core/test/google-*.test.mjs packages/kst-core/test/release-06-integration.test.mjs packages/kst-core/test/native-bootstrap.test.mjs",
    "kst:release06:check": "node scripts/kst-release-06.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "chrono-node": "2.9.0"
  }
}
